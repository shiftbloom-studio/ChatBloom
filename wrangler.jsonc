{
  // Cloudflare Workers configuration for Petal. See docs/DEPLOYMENT.md.
  //
  // `pnpm build` merges this file into `.output/server/wrangler.json`, which is what Wrangler
  // deploys. Nitro adds `main`, `assets` and `compatibility_date` (from `vite.config.ts`), so
  // they are deliberately absent here. Do not add `env` blocks: Wrangler rejects them in a
  // generated configuration. Do not leave a comma after the last entry: the build cannot
  // read it.
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  // The product's earlier name. Do not rename: a renamed Worker is a new Worker, without the
  // domains and settings of this one, and must match the project name in the dashboard.
  "name": "chatbloom",
  "workers_dev": true,
  "preview_urls": true,
  "previews": {},
  // Ends a single request after one second of CPU time; the default is 30 seconds. Rendering
  // a page takes about 10 ms. Needs the Workers Paid plan.
  "limits": {
    "cpu_ms": 1000
  },
  // Logs and trace spans share 20 million events per month on Workers Paid, then $0.60 per
  // million. Logs stay at 100%: head sampling drops a request's errors along with everything
  // else, and logging every request stays within the included events up to about 18 million
  // Worker requests per month. Traces are only needed statistically (latency), and the Worker
  // calls no other services, so 10% is enough.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  }
  // The production hostname `chat.shiftbloom.studio` is attached to the Worker in the
  // Cloudflare dashboard, under Settings > Domains & Routes. Deployments keep it.
}
