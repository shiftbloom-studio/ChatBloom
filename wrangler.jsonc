{
  // Cloudflare Workers configuration for Petal. See docs/DEPLOYMENT.md.
  //
  // `pnpm build` merges this file into `.output/server/wrangler.json`, which is what Wrangler
  // deploys. Nitro adds `main`, `assets` and `compatibility_date` (from `vite.config.ts`), so
  // they are deliberately absent here. Do not add `env` blocks: Wrangler rejects them in a
  // generated configuration. Do not leave a comma after the last entry: the build cannot
  // read it.
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  // Must match the Worker's name in the dashboard. Another name would deploy another Worker,
  // without the hostnames, the hubs and the cache of this one.
  "name": "petal",
  // No hostnames outside the zone: neither `petal.<subdomain>.workers.dev` nor the workers.dev
  // URLs of previews and versions. The zone's WAF rules and rate limit only see requests to the
  // zone's hostnames, so those URLs would reach the Worker around them. The Worker's own
  // checks, the bot check and the rate limits below, apply on every hostname. Both keys stay
  // written out: every deployment then applies them, also over a change made in the dashboard.
  // Left out, `workers_dev` would switch the workers.dev URL on again.
  "workers_dev": false,
  "preview_urls": false,

  // The chat relay. `ChatHub` is exported by `src/worker/entry.ts`. The hub keeps chat in
  // memory only; its storage holds nothing but the watchdog alarm and, while a hub has paused
  // itself, the end of the pause and its reason.
  "durable_objects": {
    "bindings": [{ "name": "CHAT_HUB", "class_name": "ChatHub" }]
  },
  // Append entries, never edit or remove one. A rollback cannot cross a deployment that
  // applied a migration.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatHub"] }],

  // Cache of the data gateway. Without an `id`, the first deployment creates the namespace
  // `petal-cache` and later deployments keep using it.
  "kv_namespaces": [{ "binding": "CACHE" }],

  // Counters only, never chat content or user names. Analytics Engine must be enabled in the
  // account, or the deployment fails.
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "petal_relay" }],

  // Counted per client IP and Cloudflare location. `namespace_id` is a number of our choosing
  // that must be unique in the account.
  "ratelimits": [
    { "name": "RATE_LIMIT", "namespace_id": "4201", "simple": { "limit": 300, "period": 60 } },
    { "name": "RATE_LIMIT_MISS", "namespace_id": "4202", "simple": { "limit": 60, "period": 60 } }
  ],

  // Version id and upload time of the running deployment, for `/api/status`.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "vars": {
    // The emergency switch. With "false", `/api/irc` answers 503 at once and every overlay
    // uses its direct connection to Twitch. Changing it in the dashboard takes effect within
    // seconds, but the next deployment sets it back to what is written here.
    "RELAY_ENABLED": "true",
    // Changing the shard count moves channels to other hubs; overlays follow as they reconnect.
    "RELAY_SHARDS": "4",
    "TWITCH_IRC_URL": "wss://irc-ws.chat.twitch.tv:443",
    // The safety switch. A hub that counts more overlays, more channels, more connections
    // within a minute or more chat lines within a minute than written here closes its
    // connections and refuses new ones for RELAY_PAUSE_MINUTES, then opens again by itself.
    // Meanwhile its overlays use their direct connection to Twitch. "0" switches a threshold
    // off. RELAY_PAUSE_CONNECTS_PER_MINUTE must stay above RELAY_PAUSE_CLIENTS: every
    // deployment makes all overlays connect again at once.
    "RELAY_PAUSE_CLIENTS": "2000",
    "RELAY_PAUSE_CHANNELS": "500",
    "RELAY_PAUSE_CONNECTS_PER_MINUTE": "3000",
    "RELAY_PAUSE_LINES_PER_MINUTE": "300000",
    "RELAY_PAUSE_FRAMES_PER_MINUTE": "10000",
    "RELAY_PAUSE_MINUTES": "15"
  },

  // Preview builds of other branches. A preview inherits no bindings or variables, so what the
  // Worker needs is repeated here. The cache, the counters and the rate limits are left out: a
  // preview runs without them. With `preview_urls` off a preview has no URL, but its build
  // still shows whether Cloudflare accepts the branch's Worker. `wrangler preview`, the build's
  // preview command, refuses to run without this block.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "CHAT_HUB", "class_name": "ChatHub" }]
    },
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
    "vars": {
      "RELAY_SHARDS": "1",
      "TWITCH_IRC_URL": "wss://irc-ws.chat.twitch.tv:443"
    }
  },

  // No `limits.cpu_ms`: the limit would apply to the hubs as well. A hub spends CPU time on
  // every line of chat, and what it may spend is only refilled by requests that reach it, so
  // a limit below the default of 30 seconds gets a busy hub reset, with all its overlays.

  // Logs and trace spans share 20 million events per month on Workers Paid, then $0.60 per
  // million. Logs stay at 100%: head sampling drops a request's errors along with everything
  // else. Traces are only needed statistically (latency), so 10% is enough.
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true
    }
  }
  // The production hostnames `petal.shiftbloom.studio` and `chat.shiftbloom.studio` are
  // attached to the Worker in the Cloudflare dashboard, under Settings > Domains & Routes.
  // Deployments keep them.
}
