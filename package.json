{
  "name": "chatis",
  "description": "Petal: a free, open-source Twitch chat overlay for OBS, with 7TV, BTTV and FFZ emotes, badges and name paints.",
  "homepage": "https://petal.shiftbloom.studio",
  "repository": "github:shiftbloom-studio/ChatBloom",
  "keywords": [
    "twitch",
    "twitch-chat",
    "chat-overlay",
    "obs",
    "streaming",
    "7tv",
    "bttv",
    "frankerfacez",
    "chatis"
  ],
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "node scripts/fontshare.ts && vite dev",
    "build": "node scripts/fontshare.ts && vite build",
    "typecheck": "tsc",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "node --import ./test/register.ts --test \"test/**/*.test.ts\"",
    "seo": "node --import ./test/register.ts scripts/seo.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.5",
    "@suid/material": "^0.19.0",
    "darkreader": "^4.9.133",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "nitro": "3.0.260903-beta",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1"
}
